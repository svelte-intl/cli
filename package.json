{
    "name": "@svelte-i18n/cli",
    "version": "1.1.0",
    "description": "CLI for @svelte-i18n/core: generate TypeScript types from flat JSON translation dictionaries",
    "type": "module",
    "bin": {
        "svelte-i18n": "./dist/index.js"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/svelte-intl/cli.git"
    },
    "main": "./dist/index.js",
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc",
        "dev": "tsx watch src/index.ts generate-types",
        "start": "node dist/index.js",
        "format": "prettier --write src",
        "format:check": "prettier --check src",
        "changeset": "changeset",
        "version": "changeset version",
        "release": "pnpm build && node scripts/publish.mjs",
        "test": "tsc && node --test test/"
    },
    "dependencies": {
        "commander": "^14.0.3",
        "picocolors": "^1.1.1"
    },
    "devDependencies": {
        "@changesets/cli": "^2.30.0",
        "@types/node": "^25.5.0",
        "prettier": "^3.8.1",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3"
    },
    "engines": {
        "node": ">=22"
    },
    "license": "MIT",
    "pnpm": {
        "onlyBuiltDependencies": [
            "esbuild"
        ]
    },
    "keywords": [
        "svelte",
        "sveltekit",
        "i18n",
        "cli",
        "typescript",
        "translations",
        "svelte-i18n"
    ],
    "homepage": "https://svelte-i18n.com/docs/type-safety"
}
